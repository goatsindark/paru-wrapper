#!/usr/bin/env bash

# PARU SAFETY WRAPPER
#
# Temporarily blocks ordinary AUR access. A single paru command may be run
# deliberately through the root-facing override launcher:
#
#   sudo /usr/local/sbin/paru <arguments> --override
#
# The real paru binary is unlocked only for that command, runs as the invoking
# normal user, and is relocked afterward.

set -u

REAL_PARU="/usr/bin/paru"
UNSAFE_URL="https://md.archlinux.org/s/SxbqukK6IA/download"

# Wrapper exit codes. These describe failures generated by this wrapper.
EX_USAGE=64          # Missing or invalid wrapper usage
EX_POLICY=65         # Command blocked by wrapper policy
EX_UNSAFE_PACKAGE=66 # Package appears on the unsafe list
EX_PRIVILEGE=67      # Root privileges required
EX_USER=68           # Invoking normal user could not be determined
EX_LOCK=69           # Could not unlock or relock /usr/bin/paru
EX_PARU_FAILED=70    # Paru itself returned an actual failure status
EX_INTERNAL=71       # Unexpected wrapper/setup failure
EX_INSTALL=72        # Wrapper installation failed

banner() {
    cat <<'BANNER'

AUR access is temporarily disabled
Use pacman or Flatpak where possible

Manual one-command override:
  sudo /usr/local/sbin/paru <arguments> --override

Read-only AUR update check:
  sudo /usr/local/sbin/paru -Qua --override

BANNER
}

fail() {
    local code=$1
    shift
    printf '%s\n' "$@" >&2
    exit "$code"
}

relock() {
    chmod 000 "$REAL_PARU" 2>/dev/null
}

install_wrapper() {
    local source_path target_user target_home target_path target_group
    local launcher_path="/usr/local/sbin/paru"
    local current_mode launcher_target
    local -a install_issues=()

    source_path=$(readlink -f "${BASH_SOURCE[0]}") || fail "$EX_INSTALL" \
        "Install error: could not resolve the wrapper source path."

    if (( EUID == 0 )); then
        target_user=${SUDO_USER:-}
        [[ -n "$target_user" && "$target_user" != "root" ]] || fail "$EX_USER" \
            "Install error: run this wrapper from a normal account, using sudo only when prompted."
        target_home=$(getent passwd "$target_user" | cut -d: -f6)
    else
        target_user=$(id -un)
        target_home=${HOME:-}
    fi

    [[ -n "$target_home" && -d "$target_home" ]] || fail "$EX_USER" \
        "Install error: could not determine the home directory for '$target_user'."

    target_group=$(id -gn "$target_user") || fail "$EX_USER" \
        "Install error: could not determine the primary group for '$target_user'."
    target_path="$target_home/.local/bin/paru"

    # Installation is considered complete only when every required item is
    # present and correct. Any failed check enters install/repair mode.
    if [[ ! -f "$target_path" ]]; then
        install_issues+=("the user wrapper is missing: $target_path")
    elif [[ ! -x "$target_path" ]]; then
        install_issues+=("the user wrapper is not executable: $target_path")
    elif [[ "$source_path" != "$(readlink -f "$target_path" 2>/dev/null)" ]] && \
         ! cmp -s -- "$source_path" "$target_path"; then
        install_issues+=("the installed wrapper differs from this copy")
    fi

    if [[ ! -L "$launcher_path" ]]; then
        install_issues+=("the privileged launcher symlink is missing: $launcher_path")
    else
        launcher_target=$(readlink -f "$launcher_path" 2>/dev/null || true)
        if [[ "$launcher_target" != "$(readlink -m "$target_path")" ]]; then
            install_issues+=("the privileged launcher points to the wrong target")
        fi
    fi

    if [[ ! -e "$REAL_PARU" ]]; then
        install_issues+=("the real paru executable is missing: $REAL_PARU")
    else
        current_mode=$(stat -c '%a' "$REAL_PARU" 2>/dev/null || true)
        if [[ "$current_mode" != "0" && "$current_mode" != "000" ]]; then
            install_issues+=("the real paru executable is not locked (current mode: ${current_mode:-unknown})")
        fi
    fi

    ((${#install_issues[@]} == 0)) && return 0

    cat <<FIRST_RUN

The paru safety wrapper is not fully installed yet, or part of the installation needs repair.

The following item$( ((${#install_issues[@]} == 1)) && printf '' || printf 's' ) need attention:
FIRST_RUN

    printf '  • %s\n' "${install_issues[@]}"

    cat <<INSTALL_PLAN

Installing or repairing it will:
  • copy this script to $target_path
  • set the wrapper permissions to 755
  • create $launcher_path as a symlink to the user wrapper
  • disable direct execution of $REAL_PARU by setting its mode to 000

Normal paru access will remain blocked unless you deliberately use:
  sudo $launcher_path <arguments> --override

Only the system-level changes will use sudo.

INSTALL_PLAN

    if [[ ! -t 0 ]]; then
        fail "$EX_USAGE" \
            "Installation confirmation is required, but this run is not interactive." \
            "Run the script directly from a terminal to install or repair it."
    fi

    read -r -p "Install or repair the paru safety wrapper now? [y/N] " install_reply
    case "$install_reply" in
        y|Y|yes|YES|Yes)
            echo
            echo "Installing paru safety wrapper..."
            ;;
        *)
            echo
            echo "Installation cancelled. No files or permissions were changed."
            exit 0
            ;;
    esac

    if (( EUID == 0 )); then
        install -d -m 755 -o "$target_user" -g "$target_group" "$target_home/.local/bin" || \
            fail "$EX_INSTALL" "Install error: could not create $target_home/.local/bin."
        install -m 755 -o "$target_user" -g "$target_group" "$source_path" "$target_path" || \
            fail "$EX_INSTALL" "Install error: could not copy the wrapper to $target_path."
        ln -sfn "$target_path" "$launcher_path" || \
            fail "$EX_INSTALL" "Install error: could not create $launcher_path."
        chmod 000 "$REAL_PARU" || \
            fail "$EX_LOCK" "Install error: could not lock $REAL_PARU with mode 000."
    else
        install -d -m 755 "$target_home/.local/bin" || \
            fail "$EX_INSTALL" "Install error: could not create $target_home/.local/bin."
        install -m 755 "$source_path" "$target_path" || \
            fail "$EX_INSTALL" "Install error: could not copy the wrapper to $target_path."

        sudo ln -sfn "$target_path" "$launcher_path" || \
            fail "$EX_INSTALL" "Install error: could not create $launcher_path."
        sudo chmod 000 "$REAL_PARU" || \
            fail "$EX_LOCK" "Install error: could not lock $REAL_PARU with mode 000."
    fi

    # Verify the completed installation instead of assuming each command left
    # the complete structure in the expected state.
    [[ -f "$target_path" && -x "$target_path" ]] || fail "$EX_INSTALL" \
        "Install verification failed: $target_path is missing or not executable."
    [[ -L "$launcher_path" ]] || fail "$EX_INSTALL" \
        "Install verification failed: $launcher_path is not a symlink."
    [[ "$(readlink -f "$launcher_path" 2>/dev/null)" == "$(readlink -m "$target_path")" ]] || \
        fail "$EX_INSTALL" "Install verification failed: $launcher_path points to the wrong target."
    current_mode=$(stat -c '%a' "$REAL_PARU" 2>/dev/null) || fail "$EX_INSTALL" \
        "Install verification failed: could not read permissions for $REAL_PARU."
    [[ "$current_mode" == "0" || "$current_mode" == "000" ]] || fail "$EX_LOCK" \
        "Install verification failed: $REAL_PARU has mode $current_mode instead of 000."

    cat <<REPORT

Paru safety wrapper installed successfully.

Wrapper:       $target_path (mode 755)
Root launcher: $launcher_path -> $target_path
Real paru:     $REAL_PARU (mode 000)

Override usage:
  sudo $launcher_path <arguments> --override

Update query:
  sudo $launcher_path -Qua --override
REPORT

    exit 0
}
install_wrapper

# CachyOS/Arch updater probes should not report a false AUR failure.
if pstree -s "$$" 2>/dev/null | grep -Eq '(cachy-update|arch-update)'; then
    exit 0
fi

banner

[[ -e "$REAL_PARU" ]] || fail "$EX_INTERNAL" \
    "Wrapper error: the real paru executable was not found at $REAL_PARU."

# Recover from an interrupted prior override. A non-root invocation is
# relaunched through the root-facing wrapper so it can restore mode 000.
current_mode=$(stat -c '%a' "$REAL_PARU" 2>/dev/null) || fail "$EX_INTERNAL" \
    "Wrapper error: could not read permissions for $REAL_PARU."

if [[ "$current_mode" != "0" && "$current_mode" != "000" ]]; then
    if (( EUID != 0 )); then
        echo "Recovery required: $REAL_PARU was left unlocked with mode $current_mode." >&2
        exec sudo /usr/local/sbin/paru "$@"
    fi

    echo "Recovery: restoring mode 000 on $REAL_PARU (was $current_mode)." >&2
    relock || fail "$EX_LOCK" \
        "Wrapper lock error: could not restore mode 000 on $REAL_PARU."

    # Continue processing the requested override after recovering.
fi

# Separate the wrapper-only --override flag from the arguments passed to paru.
override_requested=false
ARGS=()

for arg in "$@"; do
    if [[ "$arg" == "--override" ]]; then
        override_requested=true
    else
        ARGS+=("$arg")
    fi
done

if [[ "$override_requested" != true ]]; then
    fail "$EX_USAGE" \
        "Usage error: AUR access is blocked unless --override is supplied." \
        "Run: sudo /usr/local/sbin/paru <arguments> --override"
fi

(( EUID == 0 )) || fail "$EX_PRIVILEGE" \
    "Privilege error: --override requires root privileges." \
    "Run: sudo /usr/local/sbin/paru <arguments> --override"

((${#ARGS[@]} > 0)) || fail "$EX_USAGE" \
    "Usage error: no paru command or arguments were supplied before --override."

# Determine the normal account that invoked sudo.
RUN_USER=${SUDO_USER:-}

if [[ -z "$RUN_USER" || "$RUN_USER" == "root" ]]; then
    if [[ -n "${SUDO_UID:-}" && "${SUDO_UID}" != "0" ]]; then
        RUN_USER=$(getent passwd "$SUDO_UID" | cut -d: -f1)
    fi
fi

if [[ -z "$RUN_USER" || "$RUN_USER" == "root" ]] || ! id "$RUN_USER" >/dev/null 2>&1; then
    fail "$EX_USER" \
        "User-detection error: no valid normal invoking user was found." \
        "SUDO_USER=${SUDO_USER:-unset}; SUDO_UID=${SUDO_UID:-unset}" \
        "Invoke the wrapper through sudo from your normal account."
fi

# Block broad update operations. Read-only -Qua remains allowed.
for arg in "${ARGS[@]}"; do
    if [[ "$arg" == --sysupgrade || "$arg" == --sysupgrade=* ]] || \
       [[ "$arg" == -* && "$arg" == *S* && "$arg" == *u* && \
          ( "$arg" == *y* || "$arg" == *a* ) ]]; then
        fail "$EX_POLICY" \
            "Policy block: broad paru update operations are disabled." \
            "Blocked argument: $arg" \
            "Use pacman for repository updates or request a specific AUR package deliberately."
    fi
done

# Identify a likely package target for commands such as `paru -S package` and
# block it if it appears on the current unsafe-package list.
for arg in "${ARGS[@]}"; do
    [[ "$arg" == -* ]] && continue

    if unsafe_list=$(curl -sfL --max-time 10 "$UNSAFE_URL" 2>/dev/null); then
        if grep -Fxq -- "$arg" <<<"$unsafe_list"; then
            fail "$EX_UNSAFE_PACKAGE" \
                "Unsafe-package block: '$arg' appears on the current unsafe list." \
                "The real paru command was not executed."
        fi
    else
        echo "Warning: the unsafe-package list could not be fetched; proceeding with the explicit override." >&2
    fi

    break
done

# Detect the documented read-only AUR update query. In paru's query code,
# status 0 means at least one upgrade was printed and status 1 means no
# upgrades were found. Other commands do not receive this special treatment.
is_aur_update_query=false
for arg in "${ARGS[@]}"; do
    case "$arg" in
        -Qua|-Qau|-uQa|-uaQ|-aQu|-auQ)
            is_aur_update_query=true
            ;;
    esac
done

# Unlock paru, ensure it is relocked on interruption, and run it as the normal
# invoking user rather than as root.
chmod 555 "$REAL_PARU" || fail "$EX_LOCK" \
    "Wrapper lock error: could not temporarily unlock $REAL_PARU."

trap 'relock' EXIT HUP INT TERM

script -qfc "runuser -u '$RUN_USER' -- '$REAL_PARU' ${ARGS[*]}" /dev/null
paru_status=$?

if ! relock; then
    trap - EXIT HUP INT TERM
    fail "$EX_LOCK" \
        "Wrapper lock error: paru exited with status $paru_status, but $REAL_PARU could not be relocked."
fi

trap - EXIT HUP INT TERM

if [[ "$is_aur_update_query" == true && "$paru_status" -eq 1 ]]; then
    echo "No AUR updates found — override released and paru relocked."
    exit 0
fi

if (( paru_status != 0 )); then
    fail "$EX_PARU_FAILED" \
        "Paru command failed with exit status $paru_status." \
        "The override was released and $REAL_PARU was relocked." \
        "Wrapper exit status: $EX_PARU_FAILED"
fi

exit 0
